{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-base-tool.local/schemas/document.schema.json",
  "title": "Knowledge Base Canonical Document",
  "type": "object",
  "required": ["schemaVersion", "document", "coordinateSystems", "pages", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "document": {
      "type": "object",
      "required": ["id", "title", "sourceName", "createdAt", "pageCount"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "sourceName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "pageCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "coordinateSystems": { "type": "object" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "width", "height", "items"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "page", "order", "sourceIndex", "type", "bbox"],
        "properties": {
          "id": { "type": "string", "pattern": "^p[0-9]{4}-i[0-9]{6}$" },
          "page": { "type": "integer", "minimum": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "sourceIndex": { "type": "integer", "minimum": 0 },
          "type": { "type": "string" },
          "text": { "type": "string" },
          "html": { "type": "string" },
          "asset": { "type": "string" },
          "caption": { "type": "string" },
          "footnote": { "type": "string" },
          "headingLevel": { "type": "integer", "minimum": 1, "maximum": 6 },
          "bbox": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["normalized", "pdf"],
                "properties": {
                  "normalized": { "$ref": "#/$defs/box" },
                  "pdf": { "$ref": "#/$defs/box" }
                }
              }
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "box": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 4,
      "maxItems": 4
    }
  }
}
