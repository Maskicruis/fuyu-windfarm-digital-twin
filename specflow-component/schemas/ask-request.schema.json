{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow-design-assistant.local/schemas/ask-request.schema.json",
  "title": "AskRequest（文字与图片问答）",
  "type": "object",
  "anyOf": [{ "required": ["question"], "properties": { "question": { "minLength": 1 } } }, { "required": ["images"], "properties": { "images": { "minItems": 1 } } }],
  "properties": {
    "question": { "type": "string" },
    "images": { "type": "array", "maxItems": 8, "description": "先上传图片，再提交图片 ID；总大小最多 24 MB", "items": { "oneOf": [{ "type": "string", "pattern": "^img_[0-9a-f-]{36}$" }, { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^img_[0-9a-f-]{36}$" } } }] } },
    "conversationId": { "type": "string" },
    "scenario": { "enum": ["design", "research", "general"] },
    "retrievalMode": { "enum": ["auto", "knowledge", "general"] },
    "groupId": { "type": "string" },
    "docIds": { "type": "array", "items": { "type": "string" } },
    "topK": { "type": "integer", "minimum": 1, "maximum": 50 },
    "history": { "type": "array", "items": { "type": "object", "required": ["role", "content"], "properties": { "role": { "enum": ["user", "assistant"] }, "content": { "type": "string" }, "images": { "type": "array", "items": { "$ref": "chat-image.schema.json" } } } } }
  }
}
