  "components": {
    "securitySchemes": {
      "IntegrationBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required for native/cross-origin integration. Same-origin browser UI uses the local host origin policy."
      }
    },
    "schemas": {
      "Context": {
        "type": "object",
        "properties": {
          "systemId": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "unit": {
            "enum": [
              "ALL",
              "WT",
              "RD",
              "CL",
              "SS"
            ]
          },
          "scope": {
            "enum": [
              "ALL",
              "WT",
              "RD",
              "CL",
              "SS"
            ]
          },
          "object": {
            "type": "object"
          },
          "process": {
            "type": "object"
